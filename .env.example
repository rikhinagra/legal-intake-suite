# Copy this file to .env.local and fill in real values. See README.md for
# where each of these comes from and how to run the app without them set.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Direct Postgres connection string (Project Settings > Database), used to run migrations
SUPABASE_DB_URL=

# Resend API key (resend.com/api-keys), used to send transactional email
RESEND_API_KEY=
