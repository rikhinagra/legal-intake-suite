# Copy this file to .env.local and fill in real values. See README.md for
# where each of these comes from and how to run the app without them set.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Direct Postgres connection string (Project Settings > Database), used to run migrations
SUPABASE_DB_URL=

# Resend API key (resend.com/api-keys), used to send transactional email
RESEND_API_KEY=

# Your deployed site's real URL (e.g. https://your-app.vercel.app). Used to build
# absolute links for social-share previews, the sitemap, and canonical URLs.
# Safe to leave empty for local development — falls back to http://localhost:3000.
# Required in production (e.g. set in Vercel's Environment Variables) — without it,
# shared links' preview images silently point at localhost and never load.
NEXT_PUBLIC_SITE_URL=
